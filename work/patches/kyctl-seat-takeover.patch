+    if ctrl.config.session_mode() == config::SessionMode::Mono {
+        // The seat's own user takes it over: a client that lost its network logs in again
+        // within a second, while its dead session stays for up to a minute of missed pings
+        // (KEEPINTVL * KEEPCNT), or until its token expires if no websocket ever came. The
+        // client that lost the seat reconnects by itself for ten seconds; it is refused for
+        // TAKEOVER_HOLD, so that two clients of one user do not take the seat in turns.
+        static LAST_TAKEOVER: Mutex<Option<Instant>> = Mutex::new(None);
+        const TAKEOVER_HOLD: Duration = Duration::from_secs(15);
+
+        let (taken, own) = {
+            let sessions = ctrl.sessions.lock().unwrap();
+            (
+                !sessions.is_empty(),
+                sessions
+                    .values()
+                    .all(|s| s.username == auth_session.username),
+            )
+        };
+        if taken {
+            let held = {
+                let mut last = LAST_TAKEOVER.lock().unwrap();
+                let held = last.is_some_and(|at| at.elapsed() < TAKEOVER_HOLD);
+                if own && !held {
+                    *last = Some(Instant::now());
+                }
+                held
+            };
+            if !own || held {
+                warn!(
+                    "Refusing login for \"{}\": mono-client mode and a session is already active",
+                    auth_session.username
+                );
+                return HttpResponse::Conflict().json("Another client is already connected");
+            }
+            warn!(
+                "\"{}\" takes over their own session",
+                auth_session.username
+            );
+            ctrl.remove_sessions_if(|_| true, controller::SessionEndReason::ConnectionLost)
+                .await;
+        }
     }

     info!("Logging in \"{}\"...", auth_session.username);
