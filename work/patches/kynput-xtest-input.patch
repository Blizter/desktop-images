+//! Input through the X server's XTEST extension, for hosts without `/dev/uinput`
+//! (a container, or a kernel built without it). The pointer position already goes
+//! this way (`host_mouse_position.rs`); this carries keys, buttons, the wheel and
+//! relative moves too.
+
+use xcb::Xid;
+
+use crate::{Error, Result};
+
+// X11 core event codes, as XTEST's FakeInput takes them.
+const KEY_PRESS: u8 = 2;
+const KEY_RELEASE: u8 = 3;
+const BUTTON_PRESS: u8 = 4;
+const BUTTON_RELEASE: u8 = 5;
+const MOTION_NOTIFY: u8 = 6;
+
+/// X11 keycodes are the kernel's (evdev) plus 8, on a server using the evdev
+/// keycodes (XKB rules `evdev`, Xorg's default).
+const EVDEV_TO_X11: u16 = 8;
+
+pub(crate) struct XtestSink {
+    conn: xcb::Connection,
+}
+
+impl XtestSink {
+    pub(crate) fn connect() -> Result<Self> {
+        let (conn, _screen_num) = xcb::Connection::connect(None)?;
+
+        // Fails here, not on the first key, if the server lacks the extension.
+        let cookie = conn.send_request(&xcb::xtest::GetVersion {
+            major_version: 2,
+            minor_version: 2,
+        });
+        conn.wait_for_reply(cookie)?;
+
+        Ok(Self { conn })
+    }
+
+    fn fake(&self, r#type: u8, detail: u8, x: i16, y: i16) -> Result<()> {
+        self.conn.send_request(&xcb::xtest::FakeInput {
+            r#type,
+            detail,
+            time: 0,
+            root: xcb::x::Window::none(),
+            root_x: x,
+            root_y: y,
+            deviceid: 0,
+        });
+
+        self.conn.flush()?;
+
+        Ok(())
+    }
+
+    /// `keycode` is the kernel's. Those above 247 have no X11 keycode.
+    pub(crate) fn key(&self, keycode: u16, pressed: bool) -> Result<()> {
+        let detail = u8::try_from(keycode + EVDEV_TO_X11)
+            .map_err(|_| Error::InvalidScancode(keycode.into()))?;
+
+        self.fake(if pressed { KEY_PRESS } else { KEY_RELEASE }, detail, 0, 0)
+    }
+
+    /// `button` is an X11 pointer button: 1 left, 2 middle, 3 right, 8 back, 9 forward.
+    pub(crate) fn button(&self, button: u8, pressed: bool) -> Result<()> {
+        self.fake(
+            if pressed { BUTTON_PRESS } else { BUTTON_RELEASE },
+            button,
+            0,
+            0,
+        )
+    }
+
+    /// X11 has no wheel axis: a notch is a click of button 4 (up), 5 (down),
+    /// 6 (left) or 7 (right).
+    pub(crate) fn wheel(&self, button: u8, notches: i32) -> Result<()> {
+        for _ in 0..notches {
+            self.button(button, true)?;
+            self.button(button, false)?;
+        }
+
+        Ok(())
+    }
+
+    pub(crate) fn move_relative(&self, dx: i16, dy: i16) -> Result<()> {
+        // detail 1: the coordinates are relative to the pointer.
+        self.fake(MOTION_NOTIFY, 1, dx, dy)
+    }
+}
